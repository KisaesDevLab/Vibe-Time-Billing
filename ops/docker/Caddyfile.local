# SPDX-License-Identifier: Elastic-2.0
#
# Local/LAN Caddyfile — serves the appliance image's web + portal SPAs over
# HTTPS (internal CA) and proxies /api/* to the api container.
#
# HTTPS is required because the session cookie is marked `Secure` in
# production (apps/api/src/auth/cookies.ts) — over plain http on a LAN IP
# the browser drops it and login loops back to sign-in. `tls internal`
# mints a cert from Caddy's local CA; browsers show a one-time
# "not trusted" warning you click through (or import the Caddy root CA).
#
# Host is injected via the VIBE_HOST env var (set on the caddy service in
# docker-compose.local.yml). Defaults to localhost so the tracked file
# stays machine-agnostic; set VIBE_HOST=<lan-ip> to serve the LAN.
#
#   https://<VIBE_HOST>:5195 → staff app   (APP_BASE_URL)
#   https://<VIBE_HOST>:5196 → client portal (PORTAL_BASE_URL)
#   https://<VIBE_HOST>:5197 → public document intake (anonymous)

{
  # Keep internal-CA cert issuance on, but don't spin up the :80 HTTP->HTTPS
  # redirect vhosts (we publish custom ports only).
  auto_https disable_redirects
  admin off
  # TLS clients connecting to a bare IP don't send SNI, so Caddy can't match
  # the IP-keyed site and aborts the handshake. default_sni tells it which
  # server name (and cert) to assume when SNI is absent.
  default_sni {$VIBE_HOST:localhost}
}

https://{$VIBE_HOST:localhost}:5195 {
  tls internal
  encode gzip zstd

  handle /api/* {
    reverse_proxy api:3001 {
      header_up X-Real-IP {remote_host}
      header_up X-Vibe-Realm app
      transport http {
        read_timeout 120s
      }
    }
  }

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

https://{$VIBE_HOST:localhost}:5196 {
  tls internal
  encode gzip zstd

  handle /api/* {
    reverse_proxy api:3001 {
      header_up X-Real-IP {remote_host}
      header_up X-Vibe-Realm portal
      transport http {
        read_timeout 120s
      }
    }
  }

  handle {
    root * /srv/portal
    try_files {path} /index.html
    file_server
  }
}

# Public document-intake SPA. SECURITY: this origin must expose ONLY the
# anonymous public API (/api/public/intake/*) + the static intake SPA. Any
# other /api/* path is refused so a visitor on the intake host can never
# reach an authenticated staff/portal endpoint.
https://{$VIBE_HOST:localhost}:5197 {
  tls internal
  encode gzip zstd

  handle /api/public/intake/* {
    reverse_proxy api:3001 {
      header_up X-Real-IP {remote_host}
      header_up X-Vibe-Realm intake
      transport http {
        read_timeout 120s
      }
    }
  }

  handle /api/public/book/* {
    reverse_proxy api:3001 {
      header_up X-Real-IP {remote_host}
      header_up X-Vibe-Realm intake
      transport http {
        read_timeout 120s
      }
    }
  }

  handle /api/* {
    respond 404
  }

  handle {
    root * /srv/intake
    try_files {path} /index.html
    file_server
  }
}

# Cloudflare Tunnel origin. cloudflared forwards here (http://caddy:80) with
# the Host header rewritten to app.<zone> (staff) or portal.<zone> (portal)
# by the tunnel ingress, so we host-route like production. Plain HTTP is fine
# — TLS already terminated at Cloudflare's edge. Not published to the host;
# only the in-network cloudflared connector reaches it.
:80 {
  encode gzip zstd

  # Prefix match via header_regexp on Host: Caddy's `host` wildcard `*` only
  # matches one label, so `host portal.*` misses `portal.firm.com`. The Host
  # header regex matches any zone depth.
  @portal header_regexp Host (?i)^portal\.
  handle @portal {
    handle /api/* {
      reverse_proxy api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Vibe-Realm portal
        transport http {
          read_timeout 120s
        }
      }
    }
    handle {
      root * /srv/portal
      try_files {path} /index.html
      file_server
    }
  }

  # Public document-intake host (intake.<zone>). Exposes ONLY the anonymous
  # public API + the intake SPA; all other /api/* is refused.
  @intake header_regexp Host (?i)^intake\.
  handle @intake {
    handle /api/public/intake/* {
      reverse_proxy api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Vibe-Realm intake
        transport http {
          read_timeout 120s
        }
      }
    }
    handle /api/public/book/* {
      reverse_proxy api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Vibe-Realm intake
        transport http {
          read_timeout 120s
        }
      }
    }
    handle /api/* {
      respond 404
    }
    handle {
      root * /srv/intake
      try_files {path} /index.html
      file_server
    }
  }

  handle {
    handle /api/* {
      reverse_proxy api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Vibe-Realm app
        transport http {
          read_timeout 120s
        }
      }
    }
    handle {
      root * /srv/web
      try_files {path} /index.html
      file_server
    }
  }
}
