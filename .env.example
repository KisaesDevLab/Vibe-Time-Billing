# =============================================================================
# Vibe Practice Management — environment configuration
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# === Application ===
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=https://app.firm.com
PORTAL_BASE_URL=https://portal.firm.com

# === Database ===
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibe_tb
REDIS_URL=redis://localhost:6379

# === Auth: distinct realms ===
# Generate with: openssl rand -base64 64
STAFF_JWT_SECRET=replace-me-staff-jwt-secret
PORTAL_JWT_SECRET=replace-me-portal-jwt-secret

# Session cookies
STAFF_COOKIE_NAME=__vibe_app_session
PORTAL_COOKIE_NAME=__vibe_portal_session
STAFF_COOKIE_DOMAIN=app.firm.com
PORTAL_COOKIE_DOMAIN=portal.firm.com

# Step-up TOTP timeout (minutes)
STEP_UP_TIMEOUT_MINUTES=30

# Magic-link expiry (minutes)
MAGIC_LINK_TTL_MINUTES=15

# SMS OTP expiry (minutes)
SMS_OTP_TTL_MINUTES=5

# === Mail provider ===
# One of: smtp | postmark | resend | ses | emailit
MAIL_PROVIDER=smtp
MAIL_FROM="Granite Peak CPAs <[email protected]>"

# SMTP (dev defaults to MailHog in docker-compose.dev.yml)
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=

# Postmark
# MAIL_POSTMARK_TOKEN=

# Resend
# MAIL_RESEND_API_KEY=

# EmailIt (API v2)
# MAIL_EMAILIT_API_KEY=
# Attachment delivery: inline (base64, default) or url (EmailIt fetches a
# short-lived link served at {PUBLIC_BASE_URL}/api/mail-assets/:token —
# requires the appliance to be reachable from the internet).
# MAIL_EMAILIT_ATTACHMENT_MODE=inline

# AWS SES
# MAIL_SES_REGION=us-east-1
# MAIL_SES_ACCESS_KEY_ID=
# MAIL_SES_SECRET_ACCESS_KEY=

# === SMS provider ===
# One of: textlink | twilio | sns
SMS_PROVIDER=textlink

# TextLink
# SMS_TEXTLINK_API_KEY=

# Twilio
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_FROM=+15551234567

# AWS SNS
# SMS_SNS_REGION=us-east-1
# SMS_SNS_ACCESS_KEY_ID=
# SMS_SNS_SECRET_ACCESS_KEY=

# === Payment providers (firm-owned credentials) ===
PAYMENT_PROVIDER_DEFAULT=stripe
# Stripe (firm provides their own keys via admin UI; this is for development only)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# CPACharge
# CPACHARGE_API_KEY=

# === AI providers ===
AI_LOCAL_PROVIDER=ollama
AI_LOCAL_URL=http://localhost:11434
# Auto-detected at install; override here if needed
# AI_LOCAL_MODEL=qwen3:8b-q4_K_M

AI_CLOUD_PROVIDER=anthropic
# AI_CLOUD_API_KEY=
# AI_CLOUD_MODEL=claude-opus-4-7

# Default monthly cloud-AI budget in cents (firm-configurable in admin)
AI_DEFAULT_MONTHLY_BUDGET_CENTS=10000

# === Vibe AI Router (MIG-8 dual-mode) ===
# router = every AI feature goes through the appliance's Vibe AI Router
# (task classes + router policy own model choice, data boundaries, budgets,
# and cost; the AI_* provider settings above become inert). direct (the
# default) is the standalone single-install path. router mode requires BOTH
# the URL and the app token (minted at appliance provisioning) or the api
# refuses to boot. The worker needs the same set for the daily ai-cost-sync
# billing-feed pull.
VIBE_AI_MODE=direct
# VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
# VIBE_AI_TOKEN=

# === Client Intake OCR (Capture Client Info) ===
# Local GLM-OCR server on the firm's on-prem workstation. UNSET disables the
# feature (the /api/staff/ocr endpoint returns 503 and the capture UI hides
# the window path). All OCR stays on the LAN — screenshots never leave the box.
# See docs/architecture/CLIENT_INTAKE_OCR.md.
# GLM_OCR_URL=http://192.168.68.105:8082
GLM_OCR_MODEL=glm-ocr
# GLM_OCR_API_KEY=
GLM_OCR_TIMEOUT_MS=120000

# Desktop shell auto-update: folder holding latest.json + signed installers
# (served at /desktop/latest.json and /desktop/dl/<file>). Unset = no update channel.
# DESKTOP_RELEASES_DIR=/srv/vibe/desktop-releases

# === Storage paths ===
BACKUP_DIR=/backups
PDF_TEMPLATE_DIR=./apps/api/src/pdf-templates

# === Object storage (production: Backblaze B2) ===
# Dev/test default is the mock filesystem store (STORAGE_PROVIDER=mock,
# writes under STORAGE_LOCAL_PATH). Production uses Backblaze B2 — the
# firm owns the bucket + a restricted, bucket-scoped application key
# (customer-owned credentials; never the B2 master key). These B2_* vars
# are the authoritative source in prod and must be set for BOTH the api
# and worker containers. See ops/docs/storage-runbook.md for setup.
STORAGE_PROVIDER=mock
# STORAGE_PROVIDER=b2
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=your-bucket-name
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# STORAGE_LOCAL_PATH=/data/storage-mock   # mock provider only
# Parent folder for all client folders in the bucket ('' = bucket root).
# The sync worker scans only under this prefix; app-managed prefixes
# (Inbox/, messages/, branding/, intake/, signatures/, _system/) stay at
# the root. New appliances should keep the default below.
# STORAGE_TOP_PREFIX=Client Files/


# === Observability (optional) ===
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# === MCP server ===
MCP_ENABLED=true
MCP_PORT=3002

# === WebAuthn / passkeys ===
# rp_id is the bare domain (no scheme, no port) and must match what the
# browser sees in the address bar when WebAuthn is invoked. WEBAUTHN_ORIGIN
# is the full origin (scheme + host + port). For Caddy production behind
# a real domain, set rp_id=firm.com (or whatever the apex is) and origin
# to the staff URL (https://app.firm.com). Localhost dev defaults below.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Vibe Practice Management
WEBAUTHN_ORIGIN=http://localhost:5195

# --- Calendar Integration (Phases CAL-1…CAL-9) ---------------------------
# Per-staff OAuth into Microsoft 365 / Google Calendar.
#
# APPLIANCE-LEVEL OAuth app (recommended): register ONE app per provider and
# set the client id/secret here. Then every staff member connects their OWN
# calendar from Account → My Calendars by signing in — each user consents only
# for their own mailbox, with NO per-firm app registration and NO org-wide
# admin consent. Register the app's redirect URI as:
#   <APP_BASE_URL>/api/calendar/oauth/callback/microsoft
#   <APP_BASE_URL>/api/calendar/oauth/callback/google
# Microsoft: use a multi-tenant app; CALENDAR_MS_TENANT_ID=common accepts work
# + personal accounts. Delegated scopes (Calendars.ReadWrite, offline_access)
# are user-consentable, so no tenant admin is required.
# CALENDAR_MS_CLIENT_ID=
# CALENDAR_MS_CLIENT_SECRET=
# CALENDAR_MS_TENANT_ID=common
# CALENDAR_GOOGLE_CLIENT_ID=
# CALENDAR_GOOGLE_CLIENT_SECRET=
#
# (Alternatively, a firm can paste its OWN app credentials per-firm in
# Admin → Calendar integrations — stored encrypted under the firm MFK. The
# appliance-level vars above are the fallback when a firm hasn't done that.)
#
# Two-way calendar write-back gate. Enabled by the appointment booking
# module (BK-5): appointments are pushed to each staff member's connected
# calendar. Staff with read-only connections must reconnect to grant write.
FEATURE_CALENDAR_WRITE=true
# 0121 — automated voice (phone-call) appointment reminders via Twilio Voice.
# May reuse the SMS Twilio account/token; FROM must be a voice-capable number.
# VOICE_PROVIDER=console|twilio (default console = log only / no real calls)
# VOICE_PROVIDER=twilio
# VOICE_TWILIO_ACCOUNT_SID=
# VOICE_TWILIO_AUTH_TOKEN=
# VOICE_TWILIO_FROM=
# v1.5 local-LLM matching tier gate — keep false in v1.
FEATURE_LLM_CALENDAR_MATCH=false
# v2 client self-booking public links — keep false in v1 (BK-8 stub).
FEATURE_PUBLIC_BOOKING=false
# Fallback sync interval (the per-firm value in System Settings overrides).
CALENDAR_SYNC_INTERVAL_MINUTES=15
CALENDAR_SYNC_LOOKBACK_DAYS=7
CALENDAR_SYNC_LOOKAHEAD_DAYS=90
# Sent-request expiry default for the (separate) signatures module.
# Public base used in client RSVP links (defaults to PORTAL_BASE_URL).
CALENDAR_RSVP_BASE_URL=
