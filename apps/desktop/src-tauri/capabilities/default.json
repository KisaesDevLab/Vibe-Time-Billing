{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. The staff app is loaded from the firm's appliance (remote origin), so IPC must be allowed for remote URLs \u2014 any https host, plus localhost for development. Every app command needs an explicit allow-* entry here: Tauri v2 gates remote-origin IPC behind the ACL (permissions are generated via the app manifest in build.rs).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://*",
      "https://*:*",
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://*.local:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:event:default",
    "allow-list-capturable-windows",
    "allow-capture-window",
    "allow-set-tray-state",
    "allow-set-close-to-tray",
    "allow-show-main-window",
    "allow-broadcast-timers-changed",
    "allow-show-timer-widget",
    "allow-timer-widget-visible",
    "allow-toggle-timer-widget",
    "allow-resize-timer-widget",
    "allow-open-main-at",
    "allow-set-favorites",
    "allow-set-hotkeys",
    "allow-set-idle-threshold",
    "allow-set-foreground-watch",
    "allow-notify",
    "allow-set-badge",
    "allow-clear-toasts",
    "allow-test-notification",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-device-info",
    "allow-app-version",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-server-url",
    "allow-set-server-url",
    "allow-clear-server-url",
    "allow-download-and-open",
    "allow-open-external",
    "allow-set-outbox-watch",
    "allow-read-outbox-file",
    "allow-delete-outbox-file"
  ]
}
