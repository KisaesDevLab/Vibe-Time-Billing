{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Time & Billing",
  "version": "0.1.0",
  "identifier": "com.kisaes.vibe-tb",
  "build": {
    "beforeDevCommand": "pnpm --filter @vibe/web dev",
    "devUrl": "http://localhost:5195",
    "beforeBuildCommand": "pnpm --filter @vibe/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vibe Time & Billing",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
