{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Practice Management",
  "version": "0.2.1",
  "identifier": "com.kisaes.vibe-tb",
  "build": {
    "frontendDist": "../connect"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vibetb"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3Nzg2NUQyMkM5Njc0Q0EKUldUS2RKWXMwbVY0TjJtTE9XK0RrcnRSQ2xJbnE0ZGQzQzBCNUNiWE9sVW1JemRZNmY1ZmRXRy8K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Vibe Practice Management"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Vibe Practice Management",
    "longDescription": "Desktop shell for the Vibe Practice Management staff app: tray timer, notifications, UltraTax capture."
  }
}
