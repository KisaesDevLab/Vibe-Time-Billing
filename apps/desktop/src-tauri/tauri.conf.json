{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Time & Billing",
  "version": "0.2.0",
  "identifier": "com.kisaes.vibe-tb",
  "build": {
    "beforeDevCommand": "pnpm --filter @vibe/web dev",
    "devUrl": "http://localhost:5195",
    "beforeBuildCommand": "pnpm --filter @vibe/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vibe Time & Billing",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3001 http://localhost:5195 ws://localhost:5195 https://*.backblazeb2.com https://*.backblaze.com",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob: https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vibetb"]
      }
    },
    "updater": {
      "endpoints": ["https://app.kisaes.com/desktop/latest.json"],
      "pubkey": "REPLACE_WITH_OUTPUT_OF__pnpm_tauri_signer_generate",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Vibe Time & Billing"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "shortDescription": "Vibe Time & Billing",
    "longDescription": "Desktop shell for the Vibe Time & Billing staff app: tray timer, notifications, UltraTax capture."
  }
}
