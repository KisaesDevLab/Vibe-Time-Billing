  "dependencies": {
    "@vibe/core": "workspace:*",
    "@vibe/db": "workspace:*",
    "@vibe/types": "workspace:*",
    "express": "^4.19.2",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
